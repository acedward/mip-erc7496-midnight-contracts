node_modules/
out/
*.log
.DS_Store
.env

# Compiled artefacts: the generated TypeScript/JS, the ZKIR and the compiler
# metadata ARE committed (see README "The managed/ tree"). The proving and
# verifier keys are not: a k=19 circuit's .prover file is ~134 MB, they are a
# pure function of the committed ZKIR, and `scripts/compile.sh` regenerates them.
contracts/managed/*/keys/
# .bzkir is a byproduct of running zkir over a .zkir (key generation, or
# scripts/circuit-cost.sh); the .zkir files are the committed artefact.
*.bzkir

# The private-state provider (midnight-js level-private-state-provider) creates this
# LevelDB in the working directory. The generated contracts have NO private state, so it
# only ever holds the maintenance signing keys of a local deployment run.
midnight-level-db/
