// SPDX-License-Identifier: Apache-2.0
//
// One domain separator, both value domains: this contract mints the SAME 32
// bytes of colour as a shielded token and as an unshielded token. The ledger
// keeps the two apart by tag, not by value, so a consumer must key its table on
// `(address, domainSep, kind)` and will show two rows sharing one colour.
//
// `publishMetadata` therefore emits SIX events: the three standard fields for
// kind 0 (unshielded native) and the three for kind 1 (shielded native).
//
// See MIP section 4: a token is identified by (contractAddress, domainSep,
// kind), with the FULL kind byte, so these two halves are two rows.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;

export { ContractAddress, Either, Maybe, ShieldedCoinInfo, UserAddress, ZswapCoinPublicKey };

export sealed ledger _domain: Bytes<32>;
export sealed ledger _nameBytes: Bytes<32>;
export sealed ledger _nameLen: Uint<8>;
export sealed ledger _symbolBytes: Bytes<32>;
export sealed ledger _symbolLen: Uint<8>;
export sealed ledger _decimals: Uint<8>;
export ledger _publishedUnshielded: Boolean;
export ledger _publishedShielded: Boolean;

constructor(
  owner: Either<Bytes<32>, ContractAddress>,
  domain_: Bytes<32>,
  nameBytes_: Bytes<32>,
  nameLen_: Uint<8>,
  symbolBytes_: Bytes<32>,
  symbolLen_: Uint<8>,
  decimals_: Uint<8>
) {
  Ownable_initialize(owner);
  _domain = disclose(domain_);
  _nameBytes = disclose(nameBytes_);
  _nameLen = disclose(nameLen_);
  _symbolBytes = disclose(symbolBytes_);
  _symbolLen = disclose(symbolLen_);
  _decimals = disclose(decimals_);
}

/** The colour shared by both kinds: `tokenType(domainSep, this contract)`. */
export circuit tokenColor(): Bytes<32> {
  return tokenType(_domain, kernel.self());
}

export circuit domainSep(): Bytes<32> {
  return _domain;
}

export circuit decimals(): Uint<8> {
  return _decimals;
}

/**
 * @description Publishes the three standard fields for the UNSHIELDED kind.
 *
 * @dev Deliberately split from `publishShielded`: six events in one circuit
 * compile to k=20 (832 004 rows), three to k=19 (416 602). The proving key of a
 * k=20 circuit is ~270 MB and may not be provable on a memory-tight host — see
 * the cost table in the README and question Q20 of the project.
 */
export circuit publishUnshielded(): [] {
  assert(!_publishedUnshielded, "TokenMetadata: already published (unshielded)");
  _publishedUnshielded = true;
  TM_emitStandardFields(_domain, TM_KIND_UNSHIELDED(), _nameBytes, _nameLen,
                        _symbolBytes, _symbolLen, _decimals);
}

/** Publishes the three standard fields for the SHIELDED kind. */
export circuit publishShielded(): [] {
  assert(!_publishedShielded, "TokenMetadata: already published (shielded)");
  _publishedShielded = true;
  TM_emitStandardFields(_domain, TM_KIND_SHIELDED(), _nameBytes, _nameLen,
                        _symbolBytes, _symbolLen, _decimals);
}

/** Sets one metadata key for one kind (EIP-7496 dynamic trait). Owner only. */
export circuit setMetadata(kind: Uint<8>, key: Bytes<32>, valType: Uint<8>, valLen: Uint<8>, value: Bytes<189>): [] {
  Ownable_assertOnlyOwner();
  TM_emitTokenMetadata(_domain, disclose(kind), disclose(key), disclose(valType), disclose(valLen), disclose(value));
}

/** Mints the shielded form of the token. */
export circuit mintShielded(
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  amount: Uint<64>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  assert(amount > 0, "amount must be positive");
  return mintShieldedToken(_domain, disclose(amount), disclose(nonce), disclose(recipient));
}

/** Mints the unshielded form of the token — same colour, other tag. */
export circuit mintUnshielded(
  recipient: Either<ContractAddress, UserAddress>,
  amount: Uint<64>
): Bytes<32> {
  assert(amount > 0, "amount must be positive");
  return mintUnshieldedToken(_domain, disclose(amount), disclose(recipient));
}

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}
