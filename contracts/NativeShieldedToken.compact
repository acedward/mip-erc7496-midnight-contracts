// SPDX-License-Identifier: Apache-2.0
//
// A native shielded token with one static domain separator that describes
// itself on chain per ../TOKEN-METADATA.md.
//
// Composition:
//   OpenZeppelin `NativeShieldedToken`  the domain, the colour, the mint, and
//                                       the MIP-0011 name()/symbol()/decimals()
//   OpenZeppelin `Ownable`              who may update the metadata
//   `TokenMetadata`                     the events this repository is about
//
// Note on the duplicated name/symbol arguments: OpenZeppelin stores them as
// `Opaque<"string">`, which cannot be emitted (Compact cannot serialise an
// opaque host value into a circuit). The event path therefore needs the same
// text a second time as NUL-padded bytes, and the deploy script derives both
// forms from one string in the matrix.
//
// Minting is deliberately NOT owner-gated: these are reference test tokens and
// an open mint keeps the mint circuit (already k=14) from also paying for an
// ownership proof.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;
import "../node_modules/@openzeppelin/compact-contracts/token/NativeShieldedToken" prefix Token_;

export { ContractAddress, Either, Maybe, ShieldedCoinInfo, ZswapCoinPublicKey };

/** The token name in the byte form the metadata events carry. */
export sealed ledger _nameBytes: Bytes<32>;
export sealed ledger _nameLen: Uint<8>;
/** The token symbol in the byte form the metadata events carry. */
export sealed ledger _symbolBytes: Bytes<16>;
export sealed ledger _symbolLen: Uint<8>;
/** True once `publishMetadata` has run; it may run only once. */
export ledger _published: Boolean;

constructor(
  owner: Either<Bytes<32>, ContractAddress>,
  domain_: Bytes<32>,
  name_: Opaque<"string">,
  nameBytes_: Bytes<32>,
  nameLen_: Uint<8>,
  symbol_: Opaque<"string">,
  symbolBytes_: Bytes<16>,
  symbolLen_: Uint<8>,
  decimals_: Uint<8>
) {
  Ownable_initialize(owner);
  Token_initialize(domain_, name_, symbol_, decimals_);
  _nameBytes = disclose(nameBytes_);
  _nameLen = disclose(nameLen_);
  _symbolBytes = disclose(symbolBytes_);
  _symbolLen = disclose(symbolLen_);
}

/** The token's colour: `tokenType(domainSep, this contract)`. */
export circuit tokenColor(): Bytes<32> {
  return Token_tokenColor();
}

/** The domain separator this contract mints under. */
export circuit domainSep(): Bytes<32> {
  return Token__domain;
}

export circuit name(): Opaque<"string"> {
  return Token_name();
}

export circuit symbol(): Opaque<"string"> {
  return Token_symbol();
}

export circuit decimals(): Uint<8> {
  return Token_decimals();
}

/**
 * @description Publishes `name`, `symbol` and `decimals` as three TokenMetadata
 * events. Callable once — a constructor cannot emit, so the deployer calls this
 * immediately after deployment, and a second call is a mistake worth failing on.
 */
export circuit publishMetadata(): [] {
  assert(!_published, "TokenMetadata: already published");
  _published = true;
  TM_emitStandardFields(
    Token__domain,
    TM_KIND_SHIELDED(),
    _nameBytes,
    _nameLen,
    _symbolBytes,
    _symbolLen,
    Token__decimals
  );
}

/**
 * @description Sets or replaces one metadata key (EIP-7496's dynamic trait
 * update). Owner only. Last write wins for the consumer.
 */
export circuit setMetadata(key: Bytes<32>, len: Uint<8>, value: Bytes<190>): [] {
  Ownable_assertOnlyOwner();
  TM_emitTokenMetadata(
    Token__domain,
    TM_KIND_SHIELDED(),
    disclose(key),
    disclose(len),
    disclose(value)
  );
}

/**
 * @description Mints `amount` of this token to `recipient`.
 * @param {Bytes<32>} nonce - Caller-supplied and unique per mint.
 */
export circuit mint(
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  amount: Uint<64>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  return Token__mint(disclose(recipient), disclose(amount), disclose(nonce));
}

/** The current owner, for the deploy script's verification step. */
export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}
