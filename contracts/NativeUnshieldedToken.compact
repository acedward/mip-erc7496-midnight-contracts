// SPDX-License-Identifier: Apache-2.0
//
// A native UNSHIELDED token with one static domain separator that describes
// itself on chain per ../TOKEN-METADATA.md.
//
// OpenZeppelin has no unshielded counterpart to `NativeShieldedToken`, so the
// minimal body is inlined here: `mintUnshieldedToken` from the Compact standard
// library, the same shape `effectstream/mint-test-tokens` v2 uses. Access
// control and the metadata events are the shared modules.
//
// The `kind_` constructor argument exists so the reference deployment can also
// produce a deliberately WRONG declaration (a token that mints natively but
// claims `kind = 2`, i.e. ledger) — the "Ledger Liar" row of the reference set,
// which is how a consumer's `inconsistent` state gets exercised. Honest
// deployments pass `TM_KIND_UNSHIELDED()` (0).

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;

export { ContractAddress, Either, Maybe, UserAddress };

/** Domain separator fixed at construction; with the address it is the colour. */
export sealed ledger _domain: Bytes<32>;
/** The kind byte published by this contract (0 for an honest deployment). */
export sealed ledger _kind: Uint<8>;
export sealed ledger _nameBytes: Bytes<32>;
export sealed ledger _nameLen: Uint<8>;
export sealed ledger _symbolBytes: Bytes<16>;
export sealed ledger _symbolLen: Uint<8>;
export sealed ledger _decimals: Uint<8>;
export ledger _published: Boolean;

constructor(
  owner: Either<Bytes<32>, ContractAddress>,
  domain_: Bytes<32>,
  nameBytes_: Bytes<32>,
  nameLen_: Uint<8>,
  symbolBytes_: Bytes<16>,
  symbolLen_: Uint<8>,
  decimals_: Uint<8>,
  kind_: Uint<8>
) {
  Ownable_initialize(owner);
  _domain = disclose(domain_);
  _nameBytes = disclose(nameBytes_);
  _nameLen = disclose(nameLen_);
  _symbolBytes = disclose(symbolBytes_);
  _symbolLen = disclose(symbolLen_);
  _decimals = disclose(decimals_);
  _kind = disclose(kind_);
}

/** The token's colour: `tokenType(domainSep, this contract)`. */
export circuit tokenColor(): Bytes<32> {
  return tokenType(_domain, kernel.self());
}

export circuit domainSep(): Bytes<32> {
  return _domain;
}

export circuit decimals(): Uint<8> {
  return _decimals;
}

/** The kind byte this contract declares (see ../TOKEN-METADATA.md section 3). */
export circuit kind(): Uint<8> {
  return _kind;
}

/**
 * @description Publishes `name`, `symbol` and `decimals` as three TokenMetadata
 * events. Callable once.
 */
export circuit publishMetadata(): [] {
  assert(!_published, "TokenMetadata: already published");
  _published = true;
  TM_emitStandardFields(
    _domain,
    _kind,
    _nameBytes,
    _nameLen,
    _symbolBytes,
    _symbolLen,
    _decimals
  );
}

/** Sets or replaces one metadata key (EIP-7496 dynamic trait). Owner only. */
export circuit setMetadata(key: Bytes<32>, len: Uint<8>, value: Bytes<190>): [] {
  Ownable_assertOnlyOwner();
  TM_emitTokenMetadata(_domain, _kind, disclose(key), disclose(len), disclose(value));
}

/**
 * @description Mints `amount` of this token to `recipient` as an unshielded
 * UTxO. Unshielded outputs are public by construction, so `recipient` is
 * necessarily revealed on chain.
 * @return {Bytes<32>} - The colour actually minted.
 */
export circuit mint(
  recipient: Either<ContractAddress, UserAddress>,
  amount: Uint<64>
): Bytes<32> {
  assert(amount > 0, "amount must be positive");
  assert(
    recipient.is_left
      ? !(default<ContractAddress> == recipient.left)
      : !(default<UserAddress> == recipient.right),
    "invalid recipient"
  );
  return mintUnshieldedToken(_domain, disclose(amount), disclose(recipient));
}

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}
