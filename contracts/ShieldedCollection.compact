// SPDX-License-Identifier: Apache-2.0
//
// One contract, many tokens: a collection whose pieces each get their own
// domain separator — and therefore their own colour — at one address. This is
// the ERC-1155 / EIP-7496 shape the standard is modelled on, and the case a
// token indexer has to get right: five rows sharing an address, distinguished
// only by `domainSep`.
//
// Composition:
//   OpenZeppelin `NativeShieldedTokenFamily`  colour and mint, per domain
//   OpenZeppelin `Ownable`                    who may publish and update
//   `TokenMetadata`                           the events
//
// Unlike the single-token templates there is no publish-once guard: for a
// family, re-publishing a piece IS the update path the standard describes
// (last write wins). `publishPiece` is owner-gated instead.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "./TokenMetadata" prefix TM_;
import "../node_modules/@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;
import "../node_modules/@openzeppelin/compact-contracts/token/NativeShieldedTokenFamily" prefix Family_;

export { ContractAddress, Either, Maybe, ShieldedCoinInfo, ZswapCoinPublicKey };

/** The family symbol, in the byte form the metadata events carry. */
export sealed ledger _symbolBytes: Bytes<16>;
export sealed ledger _symbolLen: Uint<8>;
/** How many pieces have been minted, for a cheap read-back after deployment. */
export ledger _mintedPieces: Counter;

constructor(
  owner: Either<Bytes<32>, ContractAddress>,
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  symbolBytes_: Bytes<16>,
  symbolLen_: Uint<8>,
  decimals_: Uint<8>
) {
  Ownable_initialize(owner);
  Family_initialize(name_, symbol_, decimals_);
  _symbolBytes = disclose(symbolBytes_);
  _symbolLen = disclose(symbolLen_);
}

/** The colour of one piece: `tokenType(pieceDomain, this contract)`. */
export circuit tokenColor(pieceDomain: Bytes<32>): Bytes<32> {
  return Family_tokenColor(disclose(pieceDomain));
}

export circuit name(): Opaque<"string"> {
  return Family_name();
}

export circuit symbol(): Opaque<"string"> {
  return Family_symbol();
}

export circuit decimals(): Uint<8> {
  return Family_decimals();
}

export circuit mintedPieces(): Uint<64> {
  return _mintedPieces.read() as Uint<64>;
}

/**
 * @description Mints one unit of the piece identified by `pieceDomain`.
 * @param {Bytes<32>} nonce - Caller-supplied, unique per (piece, mint).
 */
export circuit mintPiece(
  pieceDomain: Bytes<32>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  _mintedPieces.increment(1);
  return Family__mint(disclose(pieceDomain), disclose(recipient), 1, disclose(nonce));
}

/**
 * @description Describes one piece: three TokenMetadata events carrying this
 * piece's `name` and the family's `symbol` and `decimals`. Owner only; may be
 * repeated to update (last write wins).
 *
 * @dev Three events is the ceiling: each event whose payload contains runtime
 * bytes costs ~120 000 rows, so four would push the circuit past k=19 and its
 * proving key past 200 MB. This piece's `tokenUri` and its traits therefore go
 * through `setPieceTrait` — see the cost table in the README and question Q20.
 */
export circuit publishPiece(
  pieceDomain: Bytes<32>,
  nameBytes: Bytes<32>,
  nameLen: Uint<8>
): [] {
  Ownable_assertOnlyOwner();
  TM_emitStandardFields(disclose(pieceDomain), TM_KIND_SHIELDED(),
                        disclose(nameBytes), disclose(nameLen),
                        _symbolBytes, _symbolLen, Family__decimals);
}

/** Sets or replaces one trait of one piece (EIP-7496 dynamic trait). Owner only. */
export circuit setPieceTrait(
  pieceDomain: Bytes<32>,
  key: Bytes<32>,
  len: Uint<8>,
  value: Bytes<190>
): [] {
  Ownable_assertOnlyOwner();
  TM_emitTokenMetadata(disclose(pieceDomain), TM_KIND_SHIELDED(), disclose(key),
                       disclose(len), disclose(value));
}

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}
