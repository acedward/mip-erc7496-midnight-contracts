// SPDX-License-Identifier: Apache-2.0
// The TokenMetadata standard, version 1 — see ../TOKEN-METADATA.md (normative).
//
// One event per (domainSep, kind, key, value) tuple, emitted as the standard
// library's `Misc` event named `TokenMetadata` with a 256-byte payload:
//
//   offset  0  32  domainSep   the token within this contract (ERC-1155 `id`)
//   offset 32   1  kind        bit 0: 0 unshielded / 1 shielded
//                              bit 1: 0 native UTxO / 1 ledger balances
//                              bits 2-7 reserved, MUST be zero
//   offset 33  32  key         UTF-8 key name, NUL-padded
//   offset 65   1  len         meaningful bytes of `value`, 0..190
//   offset 66 190  value       the value bytes, NUL-padded after `len`
//
// A constructor cannot emit, so contracts expose a `publishMetadata()` circuit
// that the deployer calls right after deployment.

pragma language_version >= 0.26.0;

module TokenMetadata {
  import CompactStandardLibrary;

  /** The `kind` byte of a native unshielded token. */
  export circuit KIND_UNSHIELDED(): Uint<8> { return 0; }

  /** The `kind` byte of a native shielded token. */
  export circuit KIND_SHIELDED(): Uint<8> { return 1; }

  /** Bit 1 of the `kind` byte: balances live in contract state, not in UTxOs. */
  export circuit KIND_LEDGER_FLAG(): Uint<8> { return 2; }

  /**
   * @description Emits one TokenMetadata event describing `key` = `value` for
   * the token `(this contract, domainSep, kind)`.
   *
   * Everything reaching `emit` is public: callers pass `disclose(...)` for any
   * witness-derived value.
   *
   * @param {Bytes<32>} domainSep - The token's domain separator.
   * @param {Uint<8>} kind - The kind byte (see the module header).
   * @param {Bytes<32>} key - The key name, NUL-padded to 32 bytes.
   * @param {Uint<8>} len - The number of meaningful bytes in `value`, 0..190.
   * @param {Bytes<190>} value - The value bytes, NUL-padded after `len`.
   */
  export circuit emitTokenMetadata(
    domainSep: Bytes<32>,
    kind: Uint<8>,
    key: Bytes<32>,
    len: Uint<8>,
    value: Bytes<190>
  ): [] {
    emit(Misc {
      name: pad(32, "TokenMetadata"),
      // 32 + 1 + 32 + 1 + 190 = 256
      payload: Bytes[...domainSep, kind, ...key, len, ...value]
    });
  }

  /**
   * @description Emits the three well-known display fields of one token:
   * `name`, `symbol` and `decimals`. Three events, in that order.
   *
   * @param {Bytes<32>} domainSep - The token's domain separator.
   * @param {Uint<8>} kind - The kind byte.
   * @param {Bytes<32>} name_ - The name, NUL-padded to 32 bytes.
   * @param {Uint<8>} nameLen - The meaningful length of `name_`.
   * @param {Bytes<16>} symbol_ - The symbol, NUL-padded to 16 bytes.
   * @param {Uint<8>} symbolLen - The meaningful length of `symbol_`.
   * @param {Uint<8>} decimals_ - The number of decimals (0..36).
   */
  export circuit emitStandardFields(
    domainSep: Bytes<32>,
    kind: Uint<8>,
    name_: Bytes<32>,
    nameLen: Uint<8>,
    symbol_: Bytes<16>,
    symbolLen: Uint<8>,
    decimals_: Uint<8>
  ): [] {
    emitTokenMetadata(domainSep, kind, pad(32, "name"), nameLen,
                      Bytes[...name_, ...pad(158, "")]);
    emitTokenMetadata(domainSep, kind, pad(32, "symbol"), symbolLen,
                      Bytes[...symbol_, ...pad(174, "")]);
    emitTokenMetadata(domainSep, kind, pad(32, "decimals"), 1,
                      Bytes[decimals_, ...pad(189, "")]);
  }
}
