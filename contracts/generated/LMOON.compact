  TM_emitTokenMetadata(pad(32, "umbra:lmoon"), 2, pad(32, "symbol"), 5, pad(190, "LMOON"));
  // decimals = "8" (len 1)
  TM_emitTokenMetadata(pad(32, "umbra:lmoon"), 2, pad(32, "decimals"), 1, Bytes[0x08, ...pad(189, "")]);
}

/**
