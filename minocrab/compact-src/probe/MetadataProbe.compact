// SPDX-License-Identifier: Apache-2.0
//
// MetadataProbe — the compile-and-byte-layout proof for the TokenMetadata
// payload. It is not a token: it exists so a test can call the module directly
// and assert that `Bytes[...spread]` really produces the 256 bytes of
// ../../TOKEN-METADATA.md section 2, at the documented offsets.
//
// Deployed once on the test network it also proves that a `Misc` event named
// `TokenMetadata` with a 256-byte payload survives the round trip through the
// node and the public indexer.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "../TokenMetadata" prefix TM_;

/** Number of `publish*` calls made, so the probe has some state to read back. */
export ledger _calls: Counter;

/**
 * @description Emits one arbitrary TokenMetadata event. Everything is a
 * parameter so a test can drive every field, including deliberately invalid
 * ones (a `len` above 190, a reserved kind bit) for the indexer's negative
 * fixtures.
 */
export circuit publishRaw(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  len: Uint<8>,
  value: Bytes<190>
): [] {
  _calls.increment(1);
  TM_emitTokenMetadata(disclose(domainSep), disclose(kind), disclose(key),
                       disclose(len), disclose(value));
}

/**
 * @description Emits the three standard fields (name, symbol, decimals) for one
 * token: the exact shape a conforming contract's `publishMetadata()` produces.
 */
export circuit publishStandard(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  name_: Bytes<32>,
  nameLen: Uint<8>,
  symbol_: Bytes<16>,
  symbolLen: Uint<8>,
  decimals_: Uint<8>
): [] {
  _calls.increment(1);
  TM_emitStandardFields(disclose(domainSep), disclose(kind), disclose(name_),
                        disclose(nameLen), disclose(symbol_),
                        disclose(symbolLen), disclose(decimals_));
}

/**
 * @description Emits three events with fixed literals — the golden fixture the
 * indexer's byte-exact test is recorded from.
 */
export circuit publishFixture(): [] {
  _calls.increment(1);
  TM_emitStandardFields(
    pad(32, "umbra:probe"),
    TM_KIND_SHIELDED(),
    pad(32, "Umbra Probe"), 11,
    pad(16, "UPROBE"), 6,
    6
  );
}

/** The number of publish calls seen so far. */
export circuit calls(): Uint<64> {
  return _calls.read() as Uint<64>;
}
