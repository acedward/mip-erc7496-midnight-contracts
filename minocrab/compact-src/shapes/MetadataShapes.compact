// User-requested typed metadata benchmark. This is not the deployed format.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

export ledger literalPublished: Boolean;
export ledger ledgerPublished: Boolean;
export ledger storedDomain: Bytes<32>;
export ledger storedName: Bytes<32>;
export ledger storedNameLen: Uint<8>;
export ledger storedSymbol: Bytes<16>;
export ledger storedSymbolLen: Uint<8>;
export ledger storedDecimals: Uint<8>;

circuit emitTypedMetadata(
  domainSep: Bytes<32>,
  kind: Uint<8>,
  key: Bytes<32>,
  valType: Uint<8>,
  valLen: Uint<8>,
  value: Bytes<189>
): [] {
  emit(Misc {
    name: pad(32, "TokenMetadata"),
    payload: Bytes[...domainSep, kind, ...key, valType, valLen, ...value]
  });
}

circuit emitStandardTyped(
  domainSep: Bytes<32>,
  name_: Bytes<32>,
  nameLen: Uint<8>,
  symbol_: Bytes<16>,
  symbolLen: Uint<8>,
  decimals_: Uint<8>
): [] {
  emitTypedMetadata(domainSep, 1, pad(32, "name"), 1, nameLen,
                    Bytes[...name_, ...pad(157, "")]);
  emitTypedMetadata(domainSep, 1, pad(32, "symbol"), 1, symbolLen,
                    Bytes[...symbol_, ...pad(173, "")]);
  emitTypedMetadata(domainSep, 1, pad(32, "decimals"), 2, 1,
                    Bytes[decimals_, ...pad(188, "")]);
}

export circuit literal3(): [] {
  assert(!literalPublished, "metadata already published");
  literalPublished = true;
  emitTypedMetadata(pad(32, "umbra:literal"), 1, pad(32, "name"), 1, 13,
                    pad(189, "Literal Token"));
  emitTypedMetadata(pad(32, "umbra:literal"), 1, pad(32, "symbol"), 1, 3,
                    pad(189, "LIT"));
  emitTypedMetadata(pad(32, "umbra:literal"), 1, pad(32, "decimals"), 2, 1,
                    Bytes[0x06, ...pad(188, "")]);
}

export circuit ledger3(): [] {
  assert(!ledgerPublished, "metadata already published");
  ledgerPublished = true;
  const domain = storedDomain;
  const name_ = storedName;
  const nameLen = storedNameLen;
  const symbol_ = storedSymbol;
  const symbolLen = storedSymbolLen;
  const decimals_ = storedDecimals;
  emitStandardTyped(domain, name_, nameLen, symbol_, symbolLen, decimals_);
}

export circuit runtime1(
  domainSep: Bytes<32>, kind: Uint<8>, key: Bytes<32>,
  valType: Uint<8>, valLen: Uint<8>, value: Bytes<189>
): [] {
  emitTypedMetadata(disclose(domainSep), disclose(kind), disclose(key),
                    disclose(valType), disclose(valLen), disclose(value));
}

export circuit runtime2(
  domainSep1: Bytes<32>, kind1: Uint<8>, key1: Bytes<32>,
  valType1: Uint<8>, valLen1: Uint<8>, value1: Bytes<189>,
  domainSep2: Bytes<32>, kind2: Uint<8>, key2: Bytes<32>,
  valType2: Uint<8>, valLen2: Uint<8>, value2: Bytes<189>
): [] {
  emitTypedMetadata(disclose(domainSep1), disclose(kind1), disclose(key1),
                    disclose(valType1), disclose(valLen1), disclose(value1));
  emitTypedMetadata(disclose(domainSep2), disclose(kind2), disclose(key2),
                    disclose(valType2), disclose(valLen2), disclose(value2));
}

export circuit runtime3(
  domainSep1: Bytes<32>, kind1: Uint<8>, key1: Bytes<32>,
  valType1: Uint<8>, valLen1: Uint<8>, value1: Bytes<189>,
  domainSep2: Bytes<32>, kind2: Uint<8>, key2: Bytes<32>,
  valType2: Uint<8>, valLen2: Uint<8>, value2: Bytes<189>,
  domainSep3: Bytes<32>, kind3: Uint<8>, key3: Bytes<32>,
  valType3: Uint<8>, valLen3: Uint<8>, value3: Bytes<189>
): [] {
  emitTypedMetadata(disclose(domainSep1), disclose(kind1), disclose(key1),
                    disclose(valType1), disclose(valLen1), disclose(value1));
  emitTypedMetadata(disclose(domainSep2), disclose(kind2), disclose(key2),
                    disclose(valType2), disclose(valLen2), disclose(value2));
  emitTypedMetadata(disclose(domainSep3), disclose(kind3), disclose(key3),
                    disclose(valType3), disclose(valLen3), disclose(value3));
}
